{
  "description": "Pre-gathers codebase context via Hunch parallel tree traversal before the agent acts",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "node \"$CLAUDE_PLUGIN_ROOT/dist/index.js\" --hook || hunch --hook"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
